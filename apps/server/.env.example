# apps/server environment. Copy to apps/server/.env and fill in.
# Local Supabase: `npm run db:start` prints these values (`supabase status`).

PORT=4000
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# Postgres connection (Supabase session pooler URI in production).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/postgres

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Comma-separated list of allowed browser origins; credentials are enabled.
CORS_ORIGIN=http://localhost:3000
