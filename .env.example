# ---------------------------------------------------------------------------
# E-commerce Support Copilot — environment template
# Copy to apps/web/.env.local for local development.
# ---------------------------------------------------------------------------

# Supabase (local dev values printed by `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>

# Optional: direct Postgres connection for the ingestion worker.
# Defaults to the local stack URL below.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- AI providers -----------------------------------------------------------
# Both providers default to deterministic mock mode; the app runs with no
# external credentials. Switch to openai-compatible and set base URL + key
# to use a real model/embeddings.

LLM_PROVIDER=mock
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

EMBEDDING_PROVIDER=mock
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536   (must be 1536 unless you change the kb_chunks column)

# --- Ingestion / retrieval tuning -------------------------------------------
INGESTION_CHUNK_TOKENS=180
INGESTION_CHUNK_OVERLAP_TOKENS=30
RETRIEVAL_MATCH_COUNT=8

# --- Support permissions ------------------------------------------------------
# all        agents see every ticket (default)
# assigned   agents see only their tickets plus unassigned ones
SUPPORT_AGENT_SCOPE=all

APP_URL=http://localhost:3000

# --- Optional reranker (Jina/Cohere-compatible /rerank endpoint) -------------
# RERANK_BASE_URL=https://api.jina.ai/v1
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_API_KEY=
